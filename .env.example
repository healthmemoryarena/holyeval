# =============================================================
# HolyEval Configuration
# Copy this file to .env and fill in your values
# =============================================================

# LLM API Keys (at least one required)
OPENAI_API_KEY=sk-xxx
GOOGLE_API_KEY=xxx

# HuggingFace Token (required for ESLBench data download)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx

# OpenRouter (optional — unified multi-provider access)
# OPENROUTER_API_KEY=sk-or-xxx

# Web UI port (optional, default: 8000)
# HOLYEVAL_WEB_PORT=8000

# ---- Optional: your own OpenAI-compatible gateway (vLLM / LiteLLM / a proxy) ----
# Any model name written as "[label]actual-model" is routed here instead of the
# default providers. Leave unset if you don't use one.
HOLYEVAL_GATEWAY_BASE_URL=
HOLYEVAL_GATEWAY_API_KEY=
